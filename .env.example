# Local development only. Replace passwords and secret before use.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-local-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=newsletter
POSTGRES_USER=newsletter
POSTGRES_PASSWORD=replace-with-a-local-database-password
DATABASE_URL=postgresql://newsletter:replace-with-a-local-database-password@127.0.0.1:55435/newsletter
REDIS_URL=redis://127.0.0.1:6385/0
WEB_PORT=8005
POSTGRES_PORT=55435
REDIS_PORT=6385
# DOI emails are printed locally; no actual SMTP delivery.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=newsletter@example.invalid
PUBLIC_BASE_URL=http://localhost:8005
